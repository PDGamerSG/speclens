  {
   "id": "te0361",
   "type": "text",
   "x": 4642,
   "y": 3362,
   "width": 859,
   "height": 316.25,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
