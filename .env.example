# Server only. Copy to .env. Never commit credentials.
MODEL_API_KEY=
MODEL_API_BASE_URL=https://api.meta.ai/v1
BUDGET_USD=5
DEMO_MODE=0
SPECLENS_PUBLIC=0
# Exact frontend origins when Vercel proxies requests to the persistent API.
SPECLENS_ALLOWED_ORIGINS=
# Shared with Vercel, so the hourly limit can trust the visitor address it forwards.
SPECLENS_PROXY_SECRET=

# Hindsight Cloud, or your own Hindsight HTTP endpoint.
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=
